# Lấy 2 giá trị này từ Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# KHÔNG cần SUPABASE_SERVICE_ROLE_KEY cho app này.
# Mọi thao tác ghi đều đi qua session của admin đã đăng nhập + RLS policy,
# nên không cần (và không nên) dùng service role key.
